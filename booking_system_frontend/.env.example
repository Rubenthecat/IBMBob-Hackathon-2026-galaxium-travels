# VITE_API_URL — Backend API base URL
#
# Leave this UNSET (or commented out) for local development.
# When unset the frontend uses the Vite dev-server proxy (/api → localhost:8001)
# which works whether you access the app from localhost or from another machine on
# the network (host: true is set in vite.config.ts).
#
# Only set this for production builds where the backend is on a different host:
#   VITE_API_URL=https://your-backend.example.com
#
# VITE_API_URL=http://localhost:8001
